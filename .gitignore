# Never commit the starter/UI export zips or their exploded source dirs
*.zip
customer_app_ui_src/
vendor_app_ui_src/

# Secrets — never commit
.env
.env.*
!.env.*.example
supabase/.env.r2
scripts/r2-migration/set-env.ps1

